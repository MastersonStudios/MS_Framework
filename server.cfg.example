# RedM
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_hostname "MSCore RedM"
sets sv_projectName "MSCore RedM"
sets sv_projectDesc "MSCore Roleplay Framework by Masterson Studios"
sets tags "redm, roleplay, mscore"
sets locale "de-DE"
set gamename rdr3
set sv_enforceGameBuild 1491
set onesync on
set sv_stateBagStrictMode true
set resources_useSystemChat true
set chat_showJoins false
set chat_showQuits false
set steam_webApiKey "none"
sv_maxclients 64
sv_licenseKey "CHANGE_ME"

# Database
set mysql_connection_string "mysql://redm:password@127.0.0.1/redm?charset=utf8mb4"
set mysql_slow_query_warning 500

# Offizielle RedM-Basisresources
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager-rdr3
ensure redm-map-one
ensure hardcap

# MSCore
ensure MS_LoadingScreen
ensure oxmysql
ensure MSCore
ensure MS_Banking
ensure MS_BossMenu
ensure MS_PlayerSync
ensure MS_mechat
ensure MS_pointing
ensure MS_Permadeath
ensure MS_Inventory
ensure MS_Crime
ensure MS_RestrictedAreas
ensure MS_BasicNeeds
ensure MS_Medic
ensure MS_WeaponDamage
ensure MS_HUD
ensure MS_Jail
ensure MS_ClothingShop
ensure MS_Stables
ensure MS_Trains
ensure MS_Telegrams
ensure MS_WorldBuilder
ensure MS_ResourceGuard
ensure MS_AdminMenu
ensure MS_GuarmaOnboarding
ensure MS_MapEditor
ensure MS_AdminLogout
ensure MS_Example

# Framework admins
add_ace group.admin command allow
add_ace group.admin command.quit deny
add_ace group.admin mscore.admin allow
add_ace group.admin mscore.admin.menu allow
add_ace group.admin mscore.worldbuilder allow
add_ace group.admin mscore.mapeditor allow
add_ace group.admin mscore.admin.logout allow
add_ace group.admin mscore.admin.guarma allow
add_ace group.admin mscore.admin.jail allow
add_ace group.admin mscore.admin.permadeath allow
add_ace group.admin mscore.weapon.damage allow
add_ace group.admin mscore.version.check allow
add_ace group.admin mscore.resourceguard allow
add_ace group.admin mscore.restrictedareas.bypass allow
# add_principal identifier.license:YOUR_LICENSE group.admin
