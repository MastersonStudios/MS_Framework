# ---------------------------------------------------------------------------
# MSCore RedM – txAdmin-Konfiguration
# Diese Datei wird durch recipe.yaml als server.cfg installiert.
# Werte in {{...}} werden vom txAdmin Recipe Deployer eingesetzt.
# ---------------------------------------------------------------------------

# Serverdarstellung
sv_hostname "{{serverName}} | MSCore"
sets sv_projectName "[MSCore] {{serverName}}"
sets sv_projectDesc "{{recipeDescription}}"
sets tags "redm, roleplay, mscore, masterson-studios"
sets locale "de-DE"

# RedM / Netzwerk
set gamename rdr3
sv_enforceGameBuild 1491
sv_licenseKey "{{svLicense}}"
sv_maxclients {{maxClients}}
{{serverEndpoints}}
set steam_webApiKey "none"
set resources_useSystemChat true
set onesync on
set sv_stateBagStrictMode true

# Datenbank – wird vom txAdmin-Datenbankschritt erzeugt.
set mysql_connection_string "{{dbConnectionString}}"

# Offizielle RedM-Basisresources
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager-rdr3
ensure redm-map-one
ensure hardcap

# Datenbanktreiber
ensure oxmysql

# MSCore Framework
ensure MS_LoadingScreen
ensure MSCore
ensure MS_Banking
ensure MS_BossMenu
ensure MS_PlayerSync
ensure MS_mechat
ensure MS_pointing
ensure MS_Permadeath
ensure MS_Inventory
ensure MS_Crime
ensure MS_RestrictedAreas
ensure MS_BasicNeeds
ensure MS_Medic
ensure MS_WeaponDamage
ensure MS_HUD
ensure MS_Jail
ensure MS_ClothingShop
ensure MS_Stables
ensure MS_Trains
ensure MS_Telegrams
ensure MS_WorldBuilder
ensure MS_ResourceGuard
ensure MS_AdminMenu
ensure MS_GuarmaOnboarding
ensure MS_MapEditor
ensure MS_AdminLogout
ensure MS_Example

# txAdmin- und Framework-Administratoren
add_ace group.admin command allow
add_ace group.admin command.quit deny
add_ace group.admin mscore.admin allow
add_ace group.admin mscore.admin.menu allow
add_ace group.admin mscore.worldbuilder allow
add_ace group.admin mscore.mapeditor allow
add_ace group.admin mscore.admin.logout allow
add_ace group.admin mscore.admin.guarma allow
add_ace group.admin mscore.admin.jail allow
add_ace group.admin mscore.admin.permadeath allow
add_ace group.admin mscore.weapon.damage allow
add_ace group.admin mscore.version.check allow
add_ace group.admin mscore.resourceguard allow
add_ace group.admin mscore.restrictedareas.bypass allow

# Der im txAdmin-Setup angelegte Master-Admin wird group.admin zugewiesen.
{{addPrincipalsMaster}}
